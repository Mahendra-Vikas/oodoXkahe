generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  email         String    @unique
  password      String?
  phone         String?
  city          String?
  country       String?
  bio           String?
  avatar        String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  trips         Trip[]
  notes         TripNote[]
  checklists    ChecklistItem[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Trip {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  coverImage  String?
  startDate   DateTime
  endDate     DateTime
  status      TripStatus @default(UPCOMING)
  isPublic    Boolean    @default(false)
  totalBudget Float?
  currency    String     @default("USD")
  shareToken  String?    @unique @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops       TripStop[]
  notes       TripNote[]
  expenses    Expense[]
  checklists  ChecklistItem[]

  @@map("trips")
}

model TripStop {
  id            String     @id @default(cuid())
  tripId        String
  cityName      String
  country       String?
  lat           Float?
  lng           Float?
  placeId       String?
  startDate     DateTime
  endDate       DateTime
  orderIndex    Int        @default(0)
  notes         String?
  
  // Route information
  routeData     String?         @db.Text  // JSON string with route polyline
  travelMode    TravelMode      @default(DRIVING)
  distanceTo    Float?          // Distance to next stop in km
  durationTo    Int?            // Duration to next stop in minutes
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  trip          Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities    Activity[]

  @@map("trip_stops")
}

model Activity {
  id          String   @id @default(cuid())
  stopId      String
  name        String
  description String?
  category    String?
  cost        Float?
  currency    String   @default("USD")
  startTime   DateTime?
  endTime     DateTime?
  location    String?
  lat         Float?
  lng         Float?
  imageUrl    String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  stop        TripStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model Expense {
  id          String      @id @default(cuid())
  tripId      String
  category    ExpenseCat
  description String
  amount      Float
  currency    String      @default("USD")
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now())

  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model ChecklistItem {
  id        String        @id @default(cuid())
  tripId    String
  userId    String
  label     String
  category  ChecklistCat
  isPacked  Boolean       @default(false)
  createdAt DateTime      @default(now())

  trip      Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

model TripNote {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  stopId    String?
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trip_notes")
}

model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  tripId    String?
  title     String
  content   String   @db.Text
  imageUrl  String?
  tags      String[]
  likes     Int      @default(0)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("community_posts")
}

enum Role {
  USER
  ADMIN
}

enum TripStatus {
  ONGOING
  UPCOMING
  COMPLETED
  DRAFT
}

enum ExpenseCat {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ACTIVITIES
  SHOPPING
  OTHER
}

enum ChecklistCat {
  DOCUMENTS
  CLOTHING
  ELECTRONICS
  HEALTH
  TOILETRIES
  OTHER
}

enum TravelMode {
  DRIVING
  WALKING
  TRANSIT
  BICYCLING
  FLYING
  TRAIN
  BUS
}
